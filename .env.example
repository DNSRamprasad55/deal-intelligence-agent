# ==============================================================================
# DEAL INTELLIGENCE AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in your backend directory or root directory before starting.
# Never commit real API keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Production PostgreSQL connection string or SQLite dev fallback
# PostgreSQL: postgresql://username:password@localhost:5432/deal_intelligence
# SQLite Fallback: sqlite:///./deal_intelligence.db
DATABASE_URL=sqlite:///./deal_intelligence.db

# ------------------------------------------------------------------------------
# 2. Hindsight Cloud Memory Configuration
# ------------------------------------------------------------------------------
# Official Hindsight Cloud API Key (Obtain from https://api.hindsight.vectorize.io)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight Cloud Base URL
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Persistent Global Memory Bank ID for Deal Intelligence
HINDSIGHT_BANK_ID=deal-intelligence-global

# ------------------------------------------------------------------------------
# 3. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Gemini API Key for synthesis and reflection (if using Gemini)
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Security & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (Must be at least 32 characters in production)
JWT_SECRET=change_this_to_a_secure_32_character_minimum_random_string

# JWT Algorithm and Expiration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 5. Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Deal Intelligence Agent"
VERSION="0.2.0"
APP_ENV=development
LOG_LEVEL=INFO
